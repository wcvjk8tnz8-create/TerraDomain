{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],

    /* Wrangler 用 esbuild 直接转译，不做类型检查；
       noEmit 让 tsc 只当检查器用（npm run typecheck） */
    "noEmit": true,

    /* 渐进式迁移的关键开关：
       allowJs 让 .js 与 .ts 共存，checkJs 关闭表示先不检查存量 js */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts", "src/**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "public", "scripts", "dist"]
}
