{
  "name": "subdomain-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "二级域名分发系统 · Cloudflare Workers + D1 + Cloudflare DNS API",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create subdomain-hub-db",
    "db:init": "wrangler d1 execute subdomain-hub-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute subdomain-hub-db --local --file=./schema.sql",
    "admin": "node scripts/admin.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "wrangler": "^3.90.0"
  }
}